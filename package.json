{
  "name": "java-go-python-ebook-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "book:build": "node tools/build-book.mjs",
    "docs:dev": "npm run site:sync && vitepress dev site --host 0.0.0.0",
    "docs:build": "npm run site:sync && vitepress build site",
    "docs:preview": "vitepress preview site --host 0.0.0.0",
    "export:html": "npm run book:build && node tools/export-html.mjs",
    "site:sync": "npm run book:build && node tools/sync-vitepress-site.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
